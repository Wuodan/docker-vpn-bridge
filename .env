# Remote target in VPN: TARGET_IP:TARGET_PORT
TARGET_IP=10.7.2.100
TARGET_PORT=8080

# Target for containers: DOCKER_BRIDGE_IP:LOCAL_PORT
LOCAL_PORT=18080
# set to Docker bridge IP (docker0)
# find it with:
# ip -4 addr show docker0 | awk '/inet /{print $2}' | cut -d/ -f1
# typically 172.17.0.1
DOCKER_BRIDGE_IP=172.17.0.1

# *** below used only by docker-compose-proxied.yml ***

# taget for container through proxy: DOCKER_BRIDGE_IP:LOCAL_LOG_PORT
LOCAL_LOG_PORT=18081

# local input port for proxy
MITM_LISTEN_PORT=18082

# local port for web-UI of proxy
MITM_WEB_PORT=18083
# password for web-UI of proxy
MITM_WEB_PASSWORD=ChangeMe
